# Copy to .gcloud-local.env (git-ignored) and fill in your values.
# These are NON-SECRET identifiers only. Never put API keys, tokens, or
# service-account keys in this file.

GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GAR_LOCATION=us-central1
GAR_REPOSITORY=your-artifact-registry-repo
CLOUD_RUN_SERVICE=your-cloud-run-service
