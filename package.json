{
  "name": "dishant-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run mastra:dev\"",
    "build": "node scripts/generate-openui-prompt.mjs && next build && npm run mastra:build",
    "start": "sh start.sh",
    "start:next": "next start",
    "lint": "eslint",
    "test:guardrail": "tsx --env-file=.env.local scripts/test-portfolio-guardrail.ts",
    "test:config-storage": "tsx scripts/test-model-config-storage.ts",
    "gen:openui-prompt": "node scripts/generate-openui-prompt.mjs",
    "mastra:dev": "cd mastra-server && tsx watch --env-file=../.env.local index.ts",
    "mastra:development": "mastra dev",
    "mastra:build": "cd mastra-server && npx esbuild index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:pg-native --external:@mastra/* --external:@ai-sdk/* --format=cjs",
    "mastra:start": "node mastra-server/dist/index.js",
    "devto:canonical": "tsx --env-file-if-exists=.env.local scripts/sync-devto-canonical.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.33",
    "@ai-sdk/openai": "^2.0.86",
    "@ai-sdk/openai-compatible": "^1.0.22",
    "@dishant0406/dev-to": "^1.0.4",
    "@mastra/core": "0.24.6",
    "@mastra/memory": "0.15.12",
    "@mastra/pg": "0.17.9",
    "@openuidev/react-headless": "0.9.2",
    "@openuidev/react-lang": "^0.2.8",
    "@openuidev/react-ui": "^0.12.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "lucide-react": "0.555.0",
    "markdown-to-jsx": "9.2.0",
    "next": "16.0.7",
    "next-themes": "0.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "server-only": "^0.0.1",
    "swiper": "12.0.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.23.8",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.24.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "mastra": "^0.18.9",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
