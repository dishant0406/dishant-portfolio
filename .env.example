# OpenCode Go model provider
OPENCODE_API_KEY=your-opencode-key
OPENCODE_MODEL=deepseek-v4-flash
OPENCODE_FALLBACK_MODEL=mimo-v2.5
OPENCODE_GUARDRAIL_MODEL=deepseek-v4-flash
OPENCODE_GUARDRAIL_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_HTTP_REFERER=https://dishantsharma.dev
OPENCODE_THINKING_MODE=disabled

# Optional server-side runtime model config.
# In production, this lets Cloud Run change model/fallback without redeploying.
MODEL_CONFIG_GCS_URI=gs://your-config-bucket/ai-model-config.json
MODEL_CONFIG_CACHE_TTL_SECONDS=60

# PostgreSQL Database for Memory Storage
MEMORY_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# GitHub API Token (Optional - for higher rate limits)
# Without token: 60 requests/hour, With token: 5000 requests/hour
# Create at: https://github.com/settings/tokens (no scopes needed for public data)
PROFILE_G_TOKEN=ghp_your_github_token_here

# Calendarific API Key (for Holiday Data)
# Get your free API key from https://calendarific.com/
# Free tier: 1000 requests/month (enough for 230+ countries with monthly caching)
CALENDARIFIC_API_KEY=your_calendarific_api_key_here

# CORS Configuration (Optional)
# Comma-separated list of allowed origins for API requests
# Default: https://dishantsharma.dev, https://www.dishantsharma.dev, http://localhost:3000
ALLOWED_ORIGINS=https://dishantsharma.dev,https://www.dishantsharma.dev,http://localhost:3000

# dev.to Blog
# Reads are public; the API key is optional and server-only (raises rate limits).
# Never prefix it with NEXT_PUBLIC_ — that would inline it into the client bundle.
DEVTO_USERNAME=dishant0406
DEVTO_API_KEY=[REDACTED]
