# Public site origin. Used for canonical URLs, the sitemap, Open Graph and the
# www -> apex redirect, and it must be the apex host with no trailing slash.
# Baked into the client bundle at build time, so it is passed as a Docker build
# arg. Leaving it unset falls back to the `site.url` value in src/config/config.json.
NEXT_PUBLIC_SITE_URL=https://dishantsharma.dev

# GitHub token (optional). Without it the GitHub contribution graph is hidden.
# Create at https://github.com/settings/tokens (the `read:user` scope is enough).
PROFILE_G_TOKEN=

# dev.to Blog
# Reads are public; the API key is optional and server-only (raises rate limits).
# Never prefix it with NEXT_PUBLIC_ — that would inline it into the client bundle.
#
# Writing needs a key with write access, used only by `pnpm devto:canonical`,
# which points every published article's canonical URL at its copy on this site.
DEVTO_USERNAME=dishant0406
DEVTO_API_KEY=

# Blog refresh endpoint. After publishing on dev.to, call
#   curl -X POST -d '' $NEXT_PUBLIC_SITE_URL/api/revalidate -H "Authorization: Bearer $REVALIDATE_TOKEN"
# to rebuild the blog list, post pages and sitemap now. Use `openssl rand -hex 32`.
# Unset means the endpoint always answers 401.
REVALIDATE_TOKEN=
